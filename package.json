{
  "name": "astro-theme-stone",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "start": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "serve": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "build": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs build",
    "build:pages": "node ./node_modules/astro/bin/astro.mjs build --config astro.pages.config.mjs --mode pages && node scripts/check-responsive-css.mjs",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist --project-name mizradev-website",
    "preview": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs preview",
    "astro": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@alpinejs/collapse": "3.12.3",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.5",
    "@astrojs/tailwind": "4.0.0",
    "@fontsource/inter": "5.0.8",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/astro": "^3.6.0",
    "@sanity/client": "^8.15.0",
    "@sanity/image-url": "^2.1.1",
    "@types/alpinejs": "3.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "alpinejs": "3.12.3",
    "astro": "^7.3.2",
    "astro-compress": "2.0.14",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "prettier": "3.0.2",
    "prettier-plugin-astro": "0.12.0",
    "prettier-plugin-tailwindcss": "0.5.3",
    "react": "^19.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "sanity": "^6.22.0",
    "styled-components": "^6.6.0",
    "tailwindcss": "3.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
