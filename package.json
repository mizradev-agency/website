{
  "name": "astro-theme-stone",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "start": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "serve": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "build": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs build",
    "preview": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs preview",
    "astro": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs",
    "auth:hash": "node scripts/hash-password.mjs",
    "auth:secrets": "node scripts/generate-secrets.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@alpinejs/collapse": "3.12.3",
    "@astrojs/markdoc": "^2.0.9",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.5",
    "@astrojs/tailwind": "4.0.0",
    "@fontsource/inter": "5.0.8",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@types/alpinejs": "3.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "alpinejs": "3.12.3",
    "astro": "^7.3.2",
    "astro-compress": "2.0.14",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "prettier": "3.0.2",
    "prettier-plugin-astro": "0.12.0",
    "prettier-plugin-tailwindcss": "0.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "3.3.3"
  }
}
