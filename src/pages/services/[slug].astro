---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/shared/Icon.astro';
import { getSingleton } from '../../lib/sanity';
import { serviceDetails, webPlans, contactHref } from '../../lib/services';
import { serviceVisual, serviceColors, webPlanIcons } from '../../lib/service-visuals';

export const prerender = true;
export function getStaticPaths() {
  return serviceDetails.map((detail) => ({ params: { slug: detail.slug }, props: { detail } }));
}
const { detail } = Astro.props;
const { services } = await getSingleton('home');
const service = services.items.find((item) => item.step === detail.step)!;
const href = contactHref(service.name);
const visual = serviceVisual(detail.step);
---

<Layout title={`${service.name} — Mizradev`} description={detail.description}>
  <div class="service-page" style={serviceColors(detail.step)}>
  <section class="service-hero">
    <div class="shell">
      <a class="service-back" href="/services">← Todos los servicios</a>
      <div class="service-hero-grid">
        <div class="service-hero-copy" data-reveal>
          <span class="service-tag"><Icon name={visual.icon} />{service.name}</span>
          <h1>{detail.headline}</h1>
          <p>{detail.description}</p>
          <a class="button button-dark" href={href}>Cuéntame tu proyecto <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
        </div>
        <div class="service-artwork" data-reveal aria-hidden="true">
          <div class="artwork-orbit orbit-outer"></div><div class="artwork-orbit orbit-inner"></div>
          <span class="artwork-spark spark-one"><Icon name={visual.processIcons[1]} /></span>
          <span class="artwork-spark spark-two"><Icon name={visual.scopeIcons[0] ?? 'code'} /></span>
          <span class="service-emblem"><Icon name={visual.icon} /></span>
          <span class="artwork-index">{detail.step} / SERVICIOS</span>
          <span class="artwork-label">{visual.label}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="shell section service-scope" aria-labelledby="scope-heading">
    <div class="section-intro">
      <span class="eyebrow">UNA SOLUCIÓN CON PROPÓSITO</span>
      <h2 id="scope-heading">{service.name}</h2>
      <p>{service.description}</p>
    </div>
    {detail.scope.length > 0 ? (
      <div class="scope-grid">
        {detail.scope.map(([title, text], index) => (
          <article class="scope-card" data-reveal>
            <span class="scope-symbol" aria-hidden="true"><Icon name={visual.scopeIcons[index]} /></span>
            <h3>{title}</h3><p>{text}</p>
          </article>
        ))}
      </div>
    ) : (
      <ul class="scope-list">
        {service.deliverables.map((item, index) => <li><span class="scope-symbol"><Icon name={visual.deliverableIcons[index]} /></span>{item}</li>)}
      </ul>
    )}
  </section>

  <section class="section service-process" aria-labelledby="process-heading">
    <div class="shell">
      <div class="section-intro">
        <span class="eyebrow">DE LA IDEA A LA ENTREGA</span>
        <h2 id="process-heading">Así desarrollamos tu proyecto.</h2>
        <p>Etapas claras, comunicación directa y decisiones que tomamos juntos.</p>
      </div>
      <ol class="process-grid">
        {detail.process.map(([title, text], index) => (
          <li data-reveal><div class="process-top"><span class="process-symbol"><Icon name={visual.processIcons[index]} /></span><span class="eyebrow">0{index + 1}</span></div><h3>{title}</h3><p>{text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  {detail.step === '01' && (
    <section id="planes" class="section engagement-section" aria-labelledby="plans-heading">
      <div class="shell">
        <div class="section-intro">
          <span class="eyebrow">PLANES DE DISEÑO Y DESARROLLO WEB</span>
          <h2 id="plans-heading">Elige el punto de partida de tu web.</h2>
          <p>Tres planes según el tamaño de tu proyecto. Precios base en dólares estadounidenses, con el alcance confirmado antes de empezar.</p>
        </div>
        <div class="engagement-grid web-plan-grid">
          {webPlans.map((plan, index) => (
            <article data-reveal class:list={['engagement-card', 'web-plan', { featured: index === 1 }]}>
              <span class="eyebrow">{index === 1 ? 'PARA HACER CRECER TU NEGOCIO' : index === 0 ? 'UNA OFERTA, UN OBJETIVO' : 'UNA PRESENCIA MÁS COMPLETA'}</span>
              <h3>{plan.name}</h3>
              <p>{plan.description}</p>
              <div class="plan-price"><span>Desde</span><strong>US${plan.price.toLocaleString('en-US')}</strong><span>USD · pago por proyecto</span></div>
              <ul>{plan.features.map((feature, featureIndex) => <li><span aria-hidden="true"><Icon name={webPlanIcons[index][featureIndex]} /></span>{feature}</li>)}</ul>
              <a class="button button-dark" href={contactHref(service.name, plan.name)} aria-label={`Consultar plan ${plan.name}`}>
                Elegir este plan <span aria-hidden="true"><Icon name="arrow-up-right" /></span>
              </a>
            </article>
          ))}
        </div>
        <p class="plans-note">Dominio, hosting, correos y licencias se cotizan por separado. Tiendas online, idiomas adicionales e integraciones especiales requieren una propuesta a medida.</p>
      </div>
    </section>
  )}

  <section class="section shell faq-section" aria-labelledby="faq-heading">
    <div>
      <span class="eyebrow">ANTES DE EMPEZAR</span>
      <h2 id="faq-heading">Resolvamos tus dudas.</h2>
      <p>Lo que necesitas saber sobre {service.name.toLowerCase()} para dar el siguiente paso.</p>
      <a class="text-link" href={href}>Hablemos de tu proyecto <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
    </div>
    <div class="faq-list">
      {detail.faq.map(([question, answer]) => (
        <details data-reveal><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>
      ))}
    </div>
  </section>

  <section class="shell section service-next">
    <span class="eyebrow">TU SIGUIENTE PASO</span>
    <h2>Cuéntame qué quieres lograr.</h2>
    <p>Revisemos tu idea y definamos una propuesta con alcance, tiempos y presupuesto.</p>
    <a class="button button-dark" href={href}>Consultar este servicio <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
    <a class="text-link" href="/services">← Ver todos los servicios</a>
  </section>
  </div>
</Layout>

<style>
  .service-page { --forest: var(--service-accent); --service-tint: var(--service-tint-base); }
  .service-hero { background: var(--service-tint); border-bottom: 1px solid color-mix(in srgb, var(--service-accent) 18%, transparent); padding-block: 30px 76px; overflow: hidden; }
  .service-back { font-size: 12px; display: inline-block; margin-bottom: 44px; color: var(--muted); }
  .service-back:hover { color: var(--service-accent); }
  .service-hero-grid { display: grid; grid-template-columns: 1.45fr 1fr; align-items: center; gap: 64px; }
  .service-tag { display: inline-flex; align-items: center; gap: 12px; color: var(--service-accent); font-size: 12px; font-weight: 600; }
  .service-tag :global(.icon) { font-size: 24px; }
  .service-hero h1 { font-size: clamp(38px, 4.7vw, 70px); line-height: 1.08; letter-spacing: -.055em; margin: 25px 0; max-width: 780px; }
  .service-hero-copy > p { max-width: 610px; font-size: 15px; line-height: 1.85; color: var(--muted); margin-bottom: 30px; }
  .service-page .button-dark { background: var(--service-accent); color: #fff; border-color: transparent; }
  .service-page .button-dark:hover { background: color-mix(in srgb, var(--service-accent) 82%, #000); }
  .service-artwork { position: relative; display: grid; place-items: center; min-height: 420px; isolation: isolate; }
  .service-artwork::before { content: ''; position: absolute; width: 80%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--service-light) 70%, transparent), transparent 70%); z-index: -1; }
  .artwork-orbit { position: absolute; border: 1px solid color-mix(in srgb, var(--service-accent) 22%, transparent); border-radius: 50%; aspect-ratio: 1; width: 96%; }
  .orbit-inner { width: 73%; border-style: dashed; }
  .service-emblem { display: grid; place-items: center; width: 200px; height: 200px; border-radius: 48px; transform: rotate(-9deg); background: var(--service-accent); color: #fff; box-shadow: 15px 20px 0 color-mix(in srgb, var(--service-accent) 13%, transparent); }
  .service-emblem :global(.icon) { font-size: 100px; transform: rotate(9deg); stroke-width: 1; }
  .artwork-spark { position: absolute; display: grid; place-items: center; width: 62px; height: 62px; border-radius: 19px; background: var(--paper); color: var(--service-accent); border: 1px solid color-mix(in srgb, var(--service-accent) 18%, transparent); font-size: 29px; }
  .spark-one { right: 6%; top: 9%; transform: rotate(12deg); }
  .spark-two { left: 3%; bottom: 15%; transform: rotate(-12deg); }
  .artwork-label, .artwork-index { position: absolute; font-size: 9px; font-weight: 600; letter-spacing: .13em; color: var(--service-accent); }
  .artwork-index { top: 0; left: 0; }
  .artwork-label { bottom: 0; right: 0; }
  .service-scope { padding-top: 76px; }
  .scope-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; list-style: none; padding: 0; }
  .scope-list li { display: flex; align-items: center; gap: 18px; border-top: 1px solid var(--line); padding-top: 24px; }
  .scope-list :global(.icon) { flex-shrink: 0; color: var(--forest); }
  .scope-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .scope-card { border: 1px solid var(--line); border-radius: 20px; padding: 28px; min-width: 0; background: var(--paper); }
  .scope-card:nth-child(2), .scope-card:nth-child(6) { background: var(--service-tint); border-color: transparent; }
  .scope-symbol, .process-symbol { display: inline-grid; place-items: center; width: 54px; height: 54px; border-radius: 16px; color: var(--service-accent); background: var(--service-tint); font-size: 28px; flex-shrink: 0; }
  .scope-card:nth-child(2) .scope-symbol, .scope-card:nth-child(6) .scope-symbol { background: var(--paper); }
  .scope-card h3 { font-size: 23px; line-height: 1.3; letter-spacing: -.5px; margin: 20px 0 12px; }
  .scope-card p { color: var(--muted); line-height: 1.8; margin: 0; }
  .service-process { background: var(--service-tint); border-block: 1px solid color-mix(in srgb, var(--service-accent) 15%, transparent); }
  .process-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; padding: 0; list-style: none; }
  .process-grid li { border-top: 1px solid color-mix(in srgb, var(--service-accent) 25%, transparent); padding-top: 24px; }
  .process-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .process-symbol { background: var(--paper); }
  .process-top .eyebrow { color: var(--service-accent); }
  .process-grid h3 { font-size: 23px; line-height: 1.3; margin: 24px 0 16px; letter-spacing: -.5px; }
  .process-grid p, .service-next p, .plans-note { color: var(--muted); line-height: 1.8; }
  .web-plan-grid { align-items: stretch; }
  .web-plan { min-width: 0; display: flex; flex-direction: column; }
  .web-plan h3 { overflow-wrap: anywhere; }
  .plan-price { display: flex; flex-direction: column; gap: 6px; margin-block: 24px; }
  .plan-price > span { font-size: 13px; }
  .plan-price strong { margin: 0; font-size: clamp(36px, 4vw, 52px); line-height: 1.2; }
  .web-plan ul { flex: 1; }
  .web-plan .button { white-space: normal; }
  .web-plan.featured { background: var(--service-accent); color: #fff; }
  .web-plan.featured .button { background: #fff; color: var(--service-accent); }
  .web-plan.featured .eyebrow::before { background: currentColor; }
  .web-plan ul :global(.icon) { font-size: 20px; }
  .plans-note { font-size: 13px; margin-top: 26px; max-width: 800px; }
  .service-next { border-top: 4px solid var(--service-accent); }
  .service-next h2 { font-size: clamp(32px, 4vw, 56px); line-height: 1.1; margin-block: 24px; }
  .service-next .text-link { display: flex; width: fit-content; margin-top: 28px; }
  :global(.dark) .service-page { --service-tint: color-mix(in srgb, var(--service-accent) 17%, var(--paper)); --forest: var(--service-light); }
  :global(.dark) .service-tag, :global(.dark) .scope-symbol, :global(.dark) .process-symbol, :global(.dark) .artwork-spark, :global(.dark) .artwork-index, :global(.dark) .artwork-label, :global(.dark) .process-top .eyebrow { color: var(--service-light); }
  @media (max-width: 1000px) { .process-grid, .scope-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .service-hero-grid { gap: 32px; grid-template-columns: 1.5fr 1fr; } .service-emblem { width: 150px; height: 150px; border-radius: 36px; } .service-emblem :global(.icon) { font-size: 78px; } .service-artwork { min-height: 340px; } }
  @media (max-width: 760px) { .web-plan-grid { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .service-hero-grid { grid-template-columns: 1fr; } .service-hero { padding-bottom: 40px; } .service-back { margin-bottom: 32px; } .service-artwork { min-height: 290px; width: min(340px, 100%); margin-inline: auto; } .service-hero h1 { font-size: clamp(36px, 7vw, 50px); } .artwork-orbit { width: 82%; } .orbit-inner { width: 64%; } }
  @media (max-width: 600px) { .process-grid, .scope-list, .scope-grid { grid-template-columns: 1fr; } .service-scope { padding-top: 48px; } }
</style>
