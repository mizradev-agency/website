---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/shared/PageIntro.astro';
import ProjectVisual from '../../components/shared/ProjectVisual.astro';
import Cta from '../../components/home/Cta.astro';
import { assetUrl, getProjects, getSingleton } from '../../lib/keystatic';
const projects = await getProjects();
const project = projects.find((item) => item.slug === Astro.params.slug);
if (!project) return Astro.redirect('/404');
const next =
  projects[(projects.findIndex((item) => item.slug === project.slug) + 1) % projects.length];
const { detail } = await getSingleton('caseStudies');
const { brandName } = await getSingleton('site');
---

<Layout title={`${project.name} — ${project.title} | ${brandName}`} description={project.summary}>
  <PageIntro
    eyebrow={`${detail.conceptLabel} / ${project.name}`}
    title={project.title}
    text={project.summary}
    action={detail.backLabel}
    href="/case-studies"
  />
  <div class="shell case-hero-visual">
    {
      project.image ? (
        <div class="project-visual">
          <img src={assetUrl(project.image)} alt={project.imageAlt || project.title} />
        </div>
      ) : (
        <ProjectVisual variant={project.visual} />
      )
    }
  </div>
  <section class="shell section case-overview">
    <dl class="case-meta">
      <div><dt>{detail.projectLabel}</dt><dd>{project.name}</dd></div><div>
        <dt>{detail.disciplineLabel}</dt><dd>{project.discipline}</dd>
      </div><div><dt>{detail.typeLabel}</dt><dd>{detail.typeText}</dd></div>
    </dl><div class="case-narrative">
      <div>
        <span class="eyebrow">{detail.challengeEyebrow}</span><h2>{detail.challengeHeading}</h2><p>
          {project.challenge}
        </p>
      </div><div>
        <span class="eyebrow">{detail.approachEyebrow}</span><h2>{detail.approachHeading}</h2><p>
          {project.approach}
        </p><ul>{project.scope.map((item) => <li>{item}</li>)}</ul>
      </div><div>
        <span class="eyebrow">{detail.outcomeEyebrow}</span><h2>{detail.outcomeHeading}</h2><p>
          {project.outcome}
        </p>
      </div>
    </div>
  </section>
  <div class="shell next-project">
    <a href={`/case-studies/${next.slug}`} class="text-link"
      >{detail.nextLabel} {next.name} <span aria-hidden="true">↗</span></a>
  </div><Cta />
</Layout>
