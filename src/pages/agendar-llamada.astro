---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/shared/PageIntro.astro';
import { getSingleton } from '../lib/keystatic';
const content = await getSingleton('booking');
---

<Layout title={content.seoTitle} description={content.seoDescription}>
  <PageIntro {...content.intro} showAction={false} />
  <section class="shell booking-section" aria-label={content.sectionLabel}>
    <iframe
      class="booking-calendar"
      title={content.calendarTitle}
      width="100%"
      height="760"
      src={content.calendarUrl}></iframe>
    <p class="booking-fallback">
      {content.fallbackText}
      <a class="text-link" href={content.calendarUrl} target="_blank" rel="noopener noreferrer"
        >{content.fallbackLabel}</a
      >
    </p>
  </section>
</Layout>
