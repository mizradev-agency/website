---
import Engagement from '../components/home/Engagement.astro';
import Services from '../components/home/Services.astro';
import Cta from '../components/home/Cta.astro';
import Layout from '../layouts/Layout.astro';
import { getSingleton } from '../lib/keystatic';
const content = await getSingleton('pricing');
---

<Layout title={content.seoTitle} description={content.seoDescription}>
  <div class="shell" style="padding-top:70px">
    <span class="eyebrow">{content.introPage.eyebrow}</span><h1
      style="font-size:clamp(38px,5vw,68px);line-height:1.1;letter-spacing:-2px;margin-top:24px;max-width:850px"
    >
      {content.introPage.title}
    </h1><p style="max-width:580px;margin-top:24px;color:var(--muted)">
      {content.introPage.text}
    </p>
  </div><Services /><Engagement /><Cta />
</Layout>
