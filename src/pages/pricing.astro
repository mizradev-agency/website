---
import Engagement from '../components/home/Engagement.astro';
import Services from '../components/home/Services.astro';
import Cta from '../components/home/Cta.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Servicios y propuestas a medida — Mizradev"
  description="Sitios web, sistemas a medida, aplicaciones móviles y SEO. Una propuesta adaptada al alcance de tu proyecto."
>
  <div class="shell" style="padding-top:70px">
    <span class="eyebrow">UNA PROPUESTA PARA TU PROYECTO</span><h1
      style="font-size:clamp(38px,5vw,68px);line-height:1.1;letter-spacing:-2px;margin-top:24px;max-width:850px"
    >
      Cada idea es diferente.<br />Su solución también.
    </h1><p style="max-width:580px;margin-top:24px;color:var(--muted)">
      El presupuesto depende del alcance, las funcionalidades y los tiempos. Cuéntame qué necesitas
      para preparar una propuesta a tu medida.
    </p>
  </div><Services /><Engagement /><Cta />
</Layout>
