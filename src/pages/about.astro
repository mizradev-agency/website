---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/shared/PageIntro.astro';
import About from '../components/home/About.astro';
import Expertise from '../components/home/Expertise.astro';
import Cta from '../components/home/Cta.astro';
import { assetUrl, getSingleton } from '../lib/keystatic';
const content = await getSingleton('about');
---

<Layout title={content.seoTitle} description={content.seoDescription}>
  <PageIntro {...content.intro} />
  <div class="shell about-banner">
    <img
      src={assetUrl(content.banner.image)}
      width="1280"
      height="640"
      alt={content.banner.imageAlt}
    /><div class="about-banner-note">
      <span class="eyebrow">{content.banner.eyebrow}</span><p>{content.banner.heading}</p><span
        aria-hidden="true">✳</span>
    </div>
  </div>
  <About />
  <section class="values-section section">
    <div class="shell">
      <div class="section-intro">
        <span class="eyebrow">{content.values.eyebrow}</span><h2>{content.values.heading}</h2><p>
          {content.values.text}
        </p>
      </div><div class="values-grid">
        {
          content.values.items.map((value, i) => (
            <article class="value-card" data-reveal>
              <h3>{value.name}</h3>
              <>
                <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
                <p>{value.description}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="shell section personal-note">
    <span class="eyebrow">{content.note.eyebrow}</span><h2>{content.note.heading}</h2><div>
      <p>{content.note.text}</p><a class="text-link" href={content.note.cta.href}
        >{content.note.cta.text} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <Expertise /><Cta />
</Layout>
