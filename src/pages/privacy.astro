---
import Layout from '../layouts/Layout.astro';
import { getSingleton } from '../lib/keystatic';
import { Renderer } from '@astrojs/markdoc/components';
const privacy = await getSingleton('privacy');
---

<Layout description={privacy.seoDescription} title={privacy.seoTitle}>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="sm:pb:20 flex flex-col gap-4 pb-16 text-center">
      <h1 class="text-4xl font-medium tracking-tight sm:text-5xl">{privacy.heading}</h1>
      <p class="text-base">{privacy.updatedAt}</p>
    </div>
    <div class="privacy-content">
      <Renderer stringifiedAst={JSON.stringify(privacy.content.node)} config={{}} />
    </div>
  </div>
</Layout>
<style>
  .privacy-content :global(p) {
    margin-bottom: 1.5rem;
  }
  .privacy-content :global(h2) {
    margin: 3rem 0 1.5rem;
    font-size: 1.5rem;
    font-weight: 500;
  }
  .privacy-content :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .privacy-content :global(li) {
    margin-bottom: 1rem;
  }
</style>
