---
import Layout from '../layouts/Layout.astro';
import { getSingleton } from '../lib/keystatic';
const contact = await getSingleton('contact');
const { services } = await getSingleton('home');
const email = contact.info.email;
---

<Layout title={contact.seoTitle} description={contact.seoDescription}>
  <section class="shell section contact-layout">
    <div>
      <span class="eyebrow">EL SIGUIENTE PASO EMPIEZA AQUÍ</span><h1>{contact.form.heading}</h1><p>
        {contact.form.text}
      </p><p>
        No necesitas tenerlo todo resuelto. Cuéntame qué quieres lograr y preparemos el punto de
        partida.
      </p>{
        email && (
          <a class="text-link" href={`mailto:${email}`}>
            {email} ↗
          </a>
        )
      }<div class="contact-schedule">
        <a class="button button-dark" href="/agendar-llamada"
          >¿Prefieres conversar? Agenda una llamada <span aria-hidden="true">↗</span></a>
      </div><div class="contact-back">
        <a class="text-link" href="/#servicios">← Explorar servicios</a>
      </div>
    </div>
    <form class="contact-form" data-contact-form data-email={email || ''}>
      <label for="name"
        >Tu nombre<input
          id="name"
          name="name"
          autocomplete="name"
          placeholder={contact.form.namePlaceholder}
          required
          maxlength="120"
        /></label
      >
      <label for="email"
        >Tu correo<input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder={contact.form.emailPlaceholder}
          required
          maxlength="200"
        /></label
      >
      <label for="service"
        >¿En qué puedo ayudarte?<select id="service" name="service"
          ><option value="">Selecciona un servicio</option>{
            services.items.map((item) => <option value={item.name}>{item.name}</option>)
          }<option>No estoy seguro todavía</option></select
        ></label
      >
      <label for="message"
        >Cuéntame tu idea<textarea
          id="message"
          name="message"
          rows="5"
          placeholder={contact.form.messagePlaceholder}
          required
          maxlength="5000"></textarea></label
      >
      <p class="form-note">
        {
          email
            ? 'Al continuar se abrirá tu aplicación de correo con el mensaje listo para revisar y enviar.'
            : 'El contacto directo estará disponible pronto. Por ahora puedes descargar el resumen de tu proyecto; este formulario no envía tus datos.'
        }
      </p>
      <button class="button button-dark" type="submit"
        >{email ? contact.form.submitLabel : 'Descargar mi idea'}<span aria-hidden="true">↗</span
        ></button
      ><p class="contact-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>
<script>
  function setupContact() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';
    const select = form.querySelector<HTMLSelectElement>('select');
    const service = new URLSearchParams(window.location.search).get('servicio');
    if (select && service && [...select.options].some((option) => option.value === service))
      select.value = service;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const text = `Hola, soy ${data.get('name')}.\n\nMi correo: ${data.get('email')}\nServicio: ${
        data.get('service') || 'Por definir'
      }\n\nMi idea:\n${data.get('message')}`;
      const status = form.querySelector<HTMLElement>('[role="status"]');
      if (form.dataset.email) {
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(
          'Nuevo proyecto — Mizradev'
        )}&body=${encodeURIComponent(text)}`;
        if (status)
          status.textContent =
            'Tu mensaje está preparado. Revisa y envía desde tu aplicación de correo. Si no se abrió, utiliza el correo de contacto que aparece en esta página.';
      } else {
        const url = URL.createObjectURL(new Blob([text], { type: 'text/plain;charset=utf-8' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = 'mi-proyecto-mizradev.txt';
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        if (status) status.textContent = 'Resumen descargado. No se ha enviado ningún mensaje.';
      }
    });
  }
  document.addEventListener('astro:page-load', setupContact);
  setupContact();
</script>
