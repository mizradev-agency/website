---
import Layout from '../layouts/Layout.astro';
import { getSingleton } from '../lib/keystatic';
const contact = await getSingleton('contact');
const { services } = await getSingleton('home');
const email = contact.info.email;
---

<Layout title={contact.seoTitle} description={contact.seoDescription}>
  <section class="shell section contact-layout">
    <div>
      <span class="eyebrow">{contact.eyebrow}</span><h1>{contact.form.heading}</h1><p>
        {contact.form.text}
      </p><p>
        {contact.extraText}
      </p>{
        email && (
          <a class="text-link" href={`mailto:${email}`}>
            {email} ↗
          </a>
        )
      }<div class="contact-schedule">
        <a class="button button-dark" href={contact.scheduleLink.href}
          >{contact.scheduleLink.text} <span aria-hidden="true">↗</span></a
        >
      </div><div class="contact-back">
        <a class="text-link" href={contact.backLink.href}>{contact.backLink.text}</a>
      </div>
    </div>
    <form
      class="contact-form"
      data-contact-form
      data-email={email || ''}
      data-email-subject={contact.form.emailSubject}
      data-status-email={contact.form.statusEmail}
      data-status-download={contact.form.statusDownload}
    >
      <label for="name"
        >{contact.form.nameLabel}<input
          id="name"
          name="name"
          autocomplete="name"
          placeholder={contact.form.namePlaceholder}
          required
          maxlength="120"
        /></label
      >
      <label for="email"
        >{contact.form.emailLabel}<input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder={contact.form.emailPlaceholder}
          required
          maxlength="200"
        /></label
      >
      <label for="service"
        >{contact.form.serviceLabel}<select id="service" name="service"
          ><option value="">{contact.form.servicePlaceholder}</option>{
            services.items.map((item) => <option value={item.name}>{item.name}</option>)
          }<option>{contact.form.unsureOption}</option></select
        ></label
      >
      <label for="message"
        >{contact.form.messageLabel}<textarea
          id="message"
          name="message"
          rows="5"
          placeholder={contact.form.messagePlaceholder}
          required
          maxlength="5000"></textarea></label
      >
      <p class="form-note">
        {email ? contact.form.noteEmail : contact.form.noteDownload}
      </p>
      <button class="button button-dark" type="submit"
        >{email ? contact.form.submitLabel : contact.form.downloadLabel}<span aria-hidden="true"
          >↗</span
        ></button
      ><p class="contact-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>
<script>
  function setupContact() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';
    const select = form.querySelector<HTMLSelectElement>('select');
    const service = new URLSearchParams(window.location.search).get('servicio');
    if (select && service && [...select.options].some((option) => option.value === service))
      select.value = service;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const text = `Hola, soy ${data.get('name')}.\n\nMi correo: ${data.get('email')}\nServicio: ${
        data.get('service') || 'Por definir'
      }\n\nMi idea:\n${data.get('message')}`;
      const status = form.querySelector<HTMLElement>('[role="status"]');
      if (form.dataset.email) {
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(
          form.dataset.emailSubject || ''
        )}&body=${encodeURIComponent(text)}`;
        if (status) status.textContent = form.dataset.statusEmail || '';
      } else {
        const url = URL.createObjectURL(new Blob([text], { type: 'text/plain;charset=utf-8' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = 'mi-proyecto-mizradev.txt';
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        if (status) status.textContent = form.dataset.statusDownload || '';
      }
    });
  }
  document.addEventListener('astro:page-load', setupContact);
  setupContact();
</script>
