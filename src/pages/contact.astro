---
import Layout from '../layouts/Layout.astro';
import { getSingleton } from '../lib/keystatic';
const contact = await getSingleton('contact');
const { services } = await getSingleton('home');
const email = contact.info.email;
---

<Layout title={contact.seoTitle} description={contact.seoDescription}>
  <section class="shell section contact-layout">
    <div>
      <span class="eyebrow">{contact.eyebrow}</span><h1>{contact.form.heading}</h1><p>
        {contact.form.text}
      </p><p>
        {contact.extraText}
      </p>{
        email && (
          <a class="text-link" href={`mailto:${email}`}>
            {email} ↗
          </a>
        )
      }<div class="contact-schedule">
        <a class="button button-dark" href={contact.scheduleLink.href}
          >{contact.scheduleLink.text} <span aria-hidden="true">↗</span></a
        >
      </div><div class="contact-back">
        <a class="text-link" href={contact.backLink.href}>{contact.backLink.text}</a>
      </div>
    </div>
    <form
      class="contact-form"
      data-contact-form
      data-success={contact.form.successMessage}
      method="post"
      action="/api/contact"
    >
      <label for="name"
        >{contact.form.nameLabel}<input
          id="name"
          name="name"
          autocomplete="name"
          placeholder={contact.form.namePlaceholder}
          required
          maxlength="120"
        /></label
      >
      <label for="email"
        >{contact.form.emailLabel}<input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder={contact.form.emailPlaceholder}
          required
          maxlength="200"
        /></label
      >
      <label for="service"
        >{contact.form.serviceLabel}<select id="service" name="service"
          ><option value="">{contact.form.servicePlaceholder}</option>{
            services.items.map((item) => <option value={item.name}>{item.name}</option>)
          }<option>{contact.form.unsureOption}</option></select
        ></label
      >
      <label for="message"
        >{contact.form.messageLabel}<textarea
          id="message"
          name="message"
          rows="5"
          placeholder={contact.form.messagePlaceholder}
          required
          maxlength="5000"></textarea></label
      >
      <div class="contact-trap" aria-hidden="true">
        <label
          >Deja este campo vacío<input name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <div data-turnstile></div>
      <p class="form-note">{contact.form.note}</p>
      <noscript>Activa JavaScript para enviar el formulario de forma segura.</noscript>
      <button class="button button-dark" type="submit"
        >{contact.form.submitLabel}<span aria-hidden="true">↗</span></button
      ><p class="contact-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>
<style>
  .contact-layout > * {
    min-width: 0;
  }
  .contact-schedule .button {
    max-width: 100%;
    white-space: normal;
  }
  .contact-trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  [data-turnstile] {
    min-width: 0;
    max-width: 100%;
  }
  button:disabled {
    opacity: 0.65;
    cursor: wait;
  }
</style>
<script>
  type Turnstile = {
    render: (element: HTMLElement, options: Record<string, unknown>) => string;
    reset: (id: string) => void;
    remove: (id: string) => void;
  };
  const api = () => (window as Window & { turnstile?: Turnstile }).turnstile;
  let loading: Promise<void> | undefined;
  function loadTurnstile() {
    if (api()) return Promise.resolve();
    if (!loading)
      loading = new Promise<void>((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        script.onload = () => resolve();
        script.onerror = () => {
          script.remove();
          loading = undefined;
          reject(new Error('security'));
        };
        document.head.append(script);
      });
    return loading;
  }
  async function setupContact() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';
    const select = form.querySelector<HTMLSelectElement>('select');
    const service = new URLSearchParams(location.search).get('servicio');
    if (select && service && [...select.options].some((option) => option.value === service))
      select.value = service;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[role="status"]')!;
    const container = form.querySelector<HTMLElement>('[data-turnstile]')!;
    let widget: string | undefined;
    let token = '';
    let sending = false;
    button.disabled = true;
    const cleanup = () => {
      if (widget) api()?.remove(widget);
    };
    document.addEventListener('astro:before-swap', cleanup, { once: true });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending || !form.reportValidity()) return;
      if (!token) {
        status.textContent = 'Completa la verificación de seguridad.';
        return;
      }
      sending = true;
      button.disabled = true;
      status.textContent = 'Enviando tu mensaje…';
      try {
        const values = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: values.get('name'),
            email: values.get('email'),
            service: values.get('service'),
            message: values.get('message'),
            website: values.get('website'),
            token,
          }),
          signal: AbortSignal.timeout(25000),
        });
        const result = await response.json();
        if (response.ok) {
          form.reset();
          status.textContent = form.dataset.success || result.message;
        } else
          status.textContent =
            result.message || 'No se pudo enviar el mensaje. Inténtalo de nuevo.';
      } catch {
        status.textContent =
          'No se pudo confirmar el envío. Revisa tu conexión e inténtalo de nuevo.';
      } finally {
        sending = false;
        token = '';
        if (widget) api()?.reset(widget);
      }
    });
    try {
      const response = await fetch('/api/contact', { cache: 'no-store' });
      if (!response.ok) throw new Error('config');
      const { siteKey } = await response.json();
      await loadTurnstile();
      if (!form.isConnected) return;
      widget = api()!.render(container, {
        sitekey: siteKey,
        action: 'contact',
        language: 'es',
        size: 'compact',
        callback: (value: string) => {
          token = value;
          button.disabled = sending;
        },
        'expired-callback': () => {
          token = '';
          button.disabled = true;
        },
        'error-callback': () => {
          token = '';
          button.disabled = true;
          status.textContent =
            'No se pudo verificar tu conexión. Recarga la página para intentarlo de nuevo.';
        },
      });
    } catch {
      status.textContent = 'El formulario no está disponible ahora. Inténtalo más tarde.';
    }
  }
  document.addEventListener('astro:page-load', setupContact);
  setupContact();
</script>
