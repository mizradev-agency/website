---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/shared/PageIntro.astro';
import Services from '../components/home/Services.astro';
import Expertise from '../components/home/Expertise.astro';
import Cta from '../components/home/Cta.astro';
import { getSingleton } from '../lib/keystatic';
const { services } = await getSingleton('home');
const deliverables = [
 ['Sitios corporativos y landing pages', 'Tiendas online y catálogos', 'Contenido administrable y diseño responsive'],
 ['Paneles de gestión y herramientas internas', 'Automatización de tareas', 'Integraciones entre tus servicios'],
 ['Diseño de interfaces móviles', 'Flujos claros para tus usuarios', 'Desarrollo según las necesidades del producto'],
 ['Revisión de estructura y contenidos', 'Rendimiento y SEO técnico', 'Un plan de mejoras con prioridades claras'],
];
---
<Layout title="Servicios — Diseño y desarrollo freelance | Mizradev" description="Sitios web, sistemas a medida, apps móviles y SEO. Diseño y desarrollo conectados para resolver lo que tu negocio necesita.">
  <PageIntro eyebrow="Servicios" title="Diseño, código y un siguiente paso para tu negocio." text="Desde tu primera web hasta una herramienta que simplifique tu operación. Una colaboración directa para convertir lo que necesitas en algo que puedas usar." />
  <Services />
  <section class="shell section service-deliverables"><div class="section-intro"><span class="eyebrow">DEL OBJETIVO A LA SOLUCIÓN</span><h2>Lo que podemos construir juntos.</h2><p>Elegimos las herramientas después de entender el problema. Cada propuesta se adapta a tu alcance.</p></div>
  {services.items.map((service, i) => <article class="deliverable-row"><span class="eyebrow">{service.step}</span><h3>{service.name}</h3><ul>{deliverables[i].map(item => <li>{item}</li>)}</ul><a href={`/contact?servicio=${encodeURIComponent(service.name)}`} class="round-arrow" aria-label={`Consultar sobre ${service.name}`}>↗</a></article>)}
  </section>
  <Expertise /><Cta />
</Layout>
