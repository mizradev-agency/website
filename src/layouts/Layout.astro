---
import '../styles/brand.css';
import '../styles/agenc.css';
import '../styles/experience.css';
import '../styles/hulio.css';
import '../styles/chromatic.css';
import '../styles/typography.css';
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Motion from '../components/layout/Motion.astro';
import Theme from '../components/layout/Theme.astro';
import GoogleAnalytics from '../components/layout/GoogleAnalytics.astro';
import GoogleTagManager from '../components/layout/GoogleTagManager.astro';

interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
const page = Astro.url.pathname.split('/').filter(Boolean)[0] || 'home';
---

<!doctype html>
<html lang="es">
  <head>
    <GoogleTagManager placement="head" />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light dark" />
    <Theme />
    <link
      rel="preload"
      href="/fonts/manrope/manrope-400.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope/manrope-500.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#002920" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Mizradev" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="antialiased" data-page={page}>
    <GoogleTagManager placement="body" />
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <Motion />
    <style is:global>
      [x-cloak] {
        display: none !important;
      }
    </style>
    <script>
      import Alpine from 'alpinejs';
      import collapse from '@alpinejs/collapse';

      Alpine.plugin(collapse);

      window.Alpine = Alpine;
      Alpine.start();
    </script>
  </body>
</html>
