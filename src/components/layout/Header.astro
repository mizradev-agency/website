---
import { assetUrl, getSingleton } from '../../lib/keystatic';
const site = await getSingleton('site');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---
<header class="site-header" data-site-header>
  <div class="shell nav-bar">
    <a href="/" aria-label="Mizradev, inicio" class="brand"><img src={assetUrl(site.logoDark) || '/assets/mizradev-logo.png'} width="220" height="40" alt={site.brandName} /></a>
    <nav class="desktop-nav" aria-label="Navegación principal">{site.navLinks.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.name}</a>)}</nav>
    <a href="/contact" class="button button-dark nav-cta">Hablemos de tu idea <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú"><span class="menu-word">Menú</span><span class="hamburger" aria-hidden="true"><i></i><i></i></span></button>
  </div>
  <nav id="mobile-menu" class="mobile-nav" hidden aria-label="Navegación móvil"><div class="shell">
    {site.navLinks.map((link, i) => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}><span><small>0{i+1}</small>{link.name}</span><span aria-hidden="true">↗</span></a>)}
    <a href="/contact">Hablemos de tu idea <span aria-hidden="true">↗</span></a>
    <p>Desarrollo independiente. Ideas sin límites.</p>
  </div></nav>
</header>
<script>
  let cleanupHeader: (() => void) | undefined;
  function setupHeader() {
    cleanupHeader?.();
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header) return;
    const button = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
    const menu = header.querySelector<HTMLElement>('#mobile-menu')!;
    const events = new AbortController();
    const opts = { signal: events.signal };
    function setOpen(open: boolean, returnFocus = false) {
      menu.hidden = !open;
      header.classList.toggle('menu-open', open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      if (returnFocus) button.focus();
    }
    button.addEventListener('click', () => setOpen(menu.hidden), opts);
    menu.addEventListener('click', e => { if ((e.target as Element).closest('a')) setOpen(false); }, opts);
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && !menu.hidden) setOpen(false, true); }, opts);
    document.addEventListener('click', e => { if (!header.contains(e.target as Node)) setOpen(false); }, opts);
    document.addEventListener('focusin', e => { if (!header.contains(e.target as Node)) setOpen(false); }, opts);
    const scrolled = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    window.addEventListener('scroll', scrolled, { passive: true, signal: events.signal });
    const desktop = matchMedia('(min-width: 901px)');
    desktop.addEventListener('change', () => { if (desktop.matches) setOpen(false); }, opts);
    scrolled();
    cleanupHeader = () => events.abort();
  }
  document.addEventListener('astro:page-load', setupHeader);
  document.addEventListener('astro:before-swap', () => cleanupHeader?.());
  setupHeader();
</script>
