---
import { assetUrl, getSingleton } from '../../lib/keystatic';
const site = await getSingleton('site');
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <a href="/" aria-label="Mizradev, inicio"
        ><img
          class="footer-logo"
          src={assetUrl(site.logoDark) || '/assets/mizradev-logo.png'}
          width="220"
          height="40"
          alt={site.brandName}
        /></a
      ><p>{site.footerText}</p><a class="text-link" href="/contact"
        >Construyamos algo bueno <span aria-hidden="true">↗</span></a>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.brandName}. Hecho con intención.</span><nav
        aria-label="Navegación del pie"
      >
        {site.navLinks.map((link) => <a href={link.href}>{link.name}</a>)}
      </nav><a href="#main-content">Volver arriba ↑</a>
    </div>
  </div>
</footer>
