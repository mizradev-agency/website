---
import Icon from '../shared/Icon.astro';
import { assetUrl, getSingleton } from '../../lib/sanity';
const site = await getSingleton('site');
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <a href="/" aria-label="Mizradev, inicio"
        ><img
          class="footer-logo"
          src={assetUrl(site.logoDark) || '/assets/mizradev-logo.png'}
          width="220"
          height="40"
          alt={site.brandName}
        /></a
      ><p>{site.footerText}</p><div class="footer-actions">
        <a class="text-link" href={site.footerCta.href}
          >{site.footerCta.text} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a
        ><a class="text-link" href={site.contactLink.href}
          >{site.contactLink.text} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a
        >
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.brandName}. {site.copyright}</span><nav
        aria-label="Navegación del pie"
      >
        {site.navLinks.map((link) => <a href={link.href}>{link.name}</a>)}
      </nav><a href="#main-content">{site.backToTop}</a>
    </div>
  </div>
</footer>
