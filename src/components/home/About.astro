---
import { getSingleton } from '../../lib/keystatic';
const { about } = await getSingleton('home');
---

<section id="sobre-mi" class="section shell about-section">
  <div class="about-graphic" aria-hidden="true">
    <span>INDEPENDIENTE POR ELECCIÓN.</span><div class="code-mark">&lt;<i>m</i>/&gt;</div><div
      class="graphic-caption"
    >
      <span>Una idea.<br />Muchas posibilidades.</span><span>✳</span>
    </div>
  </div><div class="about-copy">
    <span class="eyebrow">DETRÁS DE MIZRADEV</span><h2>{about.heading}</h2><p>
      {about.text}
    </p><div class="about-values">
      <span>↗ Comunicación directa</span><span>↗ Soluciones con propósito</span><span
        >↗ Cuidado en los detalles</span>
    </div><a class="text-link" href={about.cta.href}
      >{about.cta.text}<span aria-hidden="true">↗</span></a>
  </div>
</section>
