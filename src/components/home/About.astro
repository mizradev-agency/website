---
import { getSingleton } from '../../lib/keystatic';
const { about } = await getSingleton('home');
---

<section id="sobre-mi" class="section shell about-section">
  <figure class="about-photo">
    <img
      src="/assets/mizradev-retrato.webp"
      width="1200"
      height="802"
      alt="Mizradev tomando notas durante una reunión de trabajo"
      loading="lazy"
    /><figcaption>
      <span>DETRÁS DEL CÓDIGO</span><strong>Una persona real.<br />Un compromiso contigo.</strong
      ><span aria-hidden="true">✳</span>
    </figcaption>
  </figure>
  <div class="about-copy">
    <span class="eyebrow">DETRÁS DE MIZRADEV</span><h2>{about.heading}</h2><p>{about.text}</p><div
      class="about-values"
    >
      <span>↗ Comunicación directa</span><span>↗ Soluciones con propósito</span><span
        >↗ Cuidado en los detalles</span>
    </div><a class="button button-dark" href={about.cta.href}
      >{about.cta.text}<span aria-hidden="true">↗</span></a>
  </div>
</section>
<section class="collaboration shell" aria-label="Colaboración en cada paso">
  <div class="collaboration-photo">
    <img
      data-scroll-image
      src="/assets/mizradev-equipo.webp"
      width="1535"
      height="1025"
      alt="Mizradev colaborando con dos personas para revisar un proyecto digital"
      loading="lazy"
    />
  </div><div class="collaboration-caption">
    <span class="eyebrow">DE LA PRIMERA IDEA AL ÚLTIMO DETALLE</span><p>
      Las mejores soluciones<br />se construyen conversando.
    </p><a href="/contact" class="round-arrow" aria-label="Hablemos de tu proyecto">↗</a>
  </div>
</section>
