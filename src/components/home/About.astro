---
import { assetUrl, getSingleton } from '../../lib/keystatic';
const { about } = await getSingleton('home');
---

<section id="sobre-mi" class="section shell about-section">
  <figure class="about-photo">
    <img
      src={assetUrl(about.image)}
      width="1200"
      height="802"
      alt={about.imageAlt}
      loading="lazy"
    /><figcaption>
      <span>{about.photoEyebrow}</span><strong>{about.photoHeading}</strong><span aria-hidden="true"
        >✳</span
      >
    </figcaption>
  </figure>
  <div class="about-copy">
    <span class="eyebrow">{about.eyebrow}</span><h2>{about.heading}</h2><p>{about.text}</p><div
      class="about-values"
    >
      {about.values.map((value) => <span>↗ {value}</span>)}
    </div><a class="button button-dark" href={about.cta.href}
      >{about.cta.text}<span aria-hidden="true">↗</span></a
    >
  </div>
</section>
<section class="collaboration shell" aria-label="Colaboración en cada paso">
  <div class="collaboration-photo">
    <img
      data-scroll-image
      src={assetUrl(about.collaborationImage)}
      width="1535"
      height="1025"
      alt={about.collaborationAlt}
      loading="lazy"
    />
  </div><div class="collaboration-caption">
    <span class="eyebrow">{about.collaborationEyebrow}</span><p>
      {about.collaborationHeading}
    </p><a
      href={about.collaborationLink.href}
      class="round-arrow"
      aria-label={about.collaborationLink.text}>↗</a
    >
  </div>
</section>
