---
import Marquee from '../shared/Marquee.astro';
import { assetUrl, getSingleton } from '../../lib/keystatic';
const { hero } = await getSingleton('home');
---

<section class="hero shell">
  <div class="hero-eyebrow">
    <span class="eyebrow"><i class="status-dot"></i> {hero.eyebrow}</span>
  </div>
  <h1 data-hero-title>{hero.heading}</h1>
  <p class="hero-intro">{hero.text}</p>
  <div class="hero-actions-pair">
    <a class="button button-dark hero-action" href={hero.cta.href}
      >{hero.cta.text}<span aria-hidden="true">↗</span></a
    >
    <a class="text-link" href={hero.secondaryCta.href}
      >{hero.secondaryCta.text} <span aria-hidden="true">↗</span></a
    >
  </div>
  <div class="hero-showcase">
    <div class="hero-photo-window">
      <img
        data-hero-photo
        src={assetUrl(hero.image)}
        width="1535"
        height="1025"
        alt={hero.imageAlt}
        fetchpriority="high"
      />
    </div>
    <span class="photo-index">{hero.photoIndex}</span>
    <div class="showcase-label">
      <span class="status-dot"></span><div>
        <strong>{hero.showcaseHeading}</strong><span>{hero.showcaseText}</span>
      </div><a href={hero.showcaseLink.href} aria-label={hero.showcaseLink.text}>↗</a>
    </div>
    <a class="showcase-corner" href={hero.cornerLink.href}
      >{hero.cornerLink.text} <span aria-hidden="true">↓</span></a
    >
  </div>
  <div class="hero-caption">
    <span>{hero.captionLeft}</span><span>{hero.captionRight}</span>
  </div>
</section>
<Marquee />
