---
import Marquee from '../shared/Marquee.astro';
import { assetUrl, getSingleton } from '../../lib/keystatic';
const { hero } = await getSingleton('home');
---
<section class="hero shell">
  <div class="hero-eyebrow"><span class="eyebrow"><i class="status-dot"></i> MIZRADEV · DESARROLLO FREELANCE</span><span class="hero-note">De tu idea al mundo digital.</span></div>
  <div class="hero-heading"><h1>{hero.heading}</h1><a class="button button-dark" href={hero.cta.href}>{hero.cta.text}<span aria-hidden="true">↗</span></a></div>
  <div class="hero-description"><span class="hero-badge"><span aria-hidden="true">✳</span> Diseño + código + estrategia</span><p>{hero.text}</p></div>
  <div class="hero-showcase">
    <img src={assetUrl(hero.image) || "/assets/hero/image.webp"} width="1280" height="640" alt={hero.imageAlt} fetchpriority="high" />
    <div class="showcase-label"><span>INDEPENDIENTE POR ELECCIÓN</span><strong>Grandes ideas.<br />Trato cercano.</strong><a href="#servicios" aria-label="Explorar servicios">↓</a></div>
    <span class="showcase-corner">Hecho a tu medida. ↗</span>
  </div>
</section>
<Marquee />
