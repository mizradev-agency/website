---
import Marquee from '../shared/Marquee.astro';
import { assetUrl, getSingleton } from '../../lib/keystatic';
const { hero } = await getSingleton('home');
---

<section class="hero shell">
  <div class="hero-eyebrow">
    <span class="eyebrow"><i class="status-dot"></i> MIZRADEV · DESARROLLO INDEPENDIENTE</span>
  </div>
  <h1 data-hero-title>{hero.heading}</h1>
  <p class="hero-intro">{hero.text}</p>
  <div class="hero-actions-pair">
    <a class="button button-dark hero-action" href={hero.cta.href}
      >{hero.cta.text}<span aria-hidden="true">↗</span></a
    >
    <a class="text-link" href="/contact">Prefiero escribirte <span aria-hidden="true">↗</span></a>
  </div>
  <div class="hero-showcase">
    <div class="hero-photo-window">
      <img
        data-hero-photo
        src={assetUrl(hero.image)}
        width="1535"
        height="1025"
        alt={hero.imageAlt}
        fetchpriority="high"
      />
    </div>
    <span class="photo-index">01 / IDEAS QUE TOMAN FORMA</span>
    <div class="showcase-label">
      <span class="status-dot"></span><div>
        <strong>Diseño con intención.<br />Código con propósito.</strong><span
          >Tu idea, en buenas manos.</span
        >
      </div><a href="#sobre-mi" aria-label="Conoce a Mizradev">↗</a>
    </div>
    <a class="showcase-corner" href="#servicios"
      >Descubre lo que podemos crear <span aria-hidden="true">↓</span></a
    >
  </div>
  <div class="hero-caption">
    <span>DISEÑO + CÓDIGO + ESTRATEGIA</span><span>De tu idea al mundo digital. ↗</span>
  </div>
</section>
<Marquee />
