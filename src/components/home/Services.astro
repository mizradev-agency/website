---
import { getSingleton } from '../../lib/keystatic';
const { services } = await getSingleton('home');
---

<section id="servicios" class="section shell">
  <div class="section-intro">
    <span class="eyebrow">{services.eyebrow}</span><h2>{services.heading}</h2><p>
      {services.text}
    </p>
  </div>
  <div class="service-list">
    {
      services.items.map((item) => (
        <a class="service-row" href={services.cta.href}>
          <div class="service-top">
            <>
              <span class="service-number">{item.step}</span>
              <span class="service-icon" aria-hidden="true">
                {item.icon}
              </span>
            </>
          </div>
          <p>{item.description}</p>
          <>
            <h3>{item.name}</h3>
            <span class="service-bottom">
              {services.cta.text} <span aria-hidden="true">↗</span>
            </span>
          </>
        </a>
      ))
    }
  </div>
</section>
