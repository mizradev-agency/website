---
import Icon from '../shared/Icon.astro';
import { getSingleton } from '../../lib/sanity';
import { serviceHref } from '../../lib/services';
import { serviceVisual, serviceColors } from '../../lib/service-visuals';
const { services } = await getSingleton('home');
---

<section id="servicios" class="section shell">
  <div class="section-intro">
    <span class="eyebrow">{services.eyebrow}</span><h2>{services.heading}</h2><p>
      {services.text}
    </p>
  </div>
  <div class="service-list">
    {
      services.items.map((item) => (
        <a class="service-row" href={serviceHref(item.step)} style={serviceColors(item.step)} data-reveal>
          <div class="service-top">
            <>
              <span class="service-number">{item.step}</span>
              <span class="service-icon" aria-hidden="true">
                <Icon name={serviceVisual(item.step).icon} />
              </span>
            </>
          </div>
          <p>{item.description}</p>
          <>
            <h3>{item.name}</h3>
            <span class="service-bottom">
              Explorar servicio <span aria-hidden="true"><Icon name="arrow-up-right" /></span>
            </span>
          </>
        </a>
      ))
    }
  </div>
</section>

<style>
  .service-row { --service-tint: var(--service-tint-base); }
  .service-row .service-top { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .service-row .service-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--service-tint); color: var(--service-accent); font-size: 25px; }
  .service-list .service-row:hover { background: var(--service-tint); }
  .service-row:hover .service-bottom > span { background: var(--service-accent); color: #fff; border-color: transparent; }
  :global(.dark) .service-row { --service-tint: color-mix(in srgb, var(--service-accent) 18%, var(--paper)); }
  :global(.dark) .service-row .service-icon { color: var(--service-light); }
  @media (max-width: 600px) { .service-row .service-icon { width: 32px; height: 32px; font-size: 20px; border-radius: 9px; } }
</style>
