---
import ProjectCard from '../shared/ProjectCard.astro';
import { getProjects, getSingleton } from '../../lib/keystatic';
const projects = await getProjects();
const { projects: content } = await getSingleton('home');
---

<section id="proyectos" class="projects-section section">
  <div class="shell">
    <div class="section-intro">
      <span class="eyebrow">{content.eyebrow}</span><h2>{content.heading}</h2><p>{content.text}</p>
    </div>
    <div class="projects-grid">
      {
        projects
          .filter((project) => project.featured)
          .map((project) => <ProjectCard project={project} />)
      }
    </div>
    <div class="projects-bottom">
      <span>{content.footerText}</span><a href={content.cta.href} class="text-link"
        >{content.cta.text} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
