---
import { getSingleton } from '../../lib/keystatic';
const { expertise } = await getSingleton('home');
---

<section id="proceso" class="section process-section">
  <div class="shell">
    <div class="section-intro">
      <span class="eyebrow">CÓMO TRABAJAMOS</span><h2>{expertise.heading}</h2><p>
        Siempre sabrás en qué estamos y qué viene después.
      </p>
    </div><div class="process-grid">
      {
        expertise.items.map((item, i) => (
          <div class="process-step">
            <h3>{item.name}</h3>
            <>
              <span class="process-number">0{i + 1}</span>
              <p>{item.description}</p>
            </>
          </div>
        ))
      }
    </div>
  </div>
</section>
