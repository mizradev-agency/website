---
import { getSingleton } from '../../lib/sanity';
import Icon from '../shared/Icon.astro';
const { expertise } = await getSingleton('home');
const processIcons = ['message', 'palette', 'code', 'rocket'];
---

<section id="proceso" class="section process-section">
  <div class="shell">
    <div class="section-intro">
      <span class="eyebrow">{expertise.eyebrow}</span><h2>{expertise.heading}</h2><p>
        {expertise.text}
      </p>
    </div><div class="process-grid">
      {
        expertise.items.map((item, i) => (
          <div class="process-step" data-reveal>
            <span class="process-illustration" aria-hidden="true"><Icon name={processIcons[i] ?? 'workflow'} /></span>
            <h3>{item.name}</h3>
            <>
              <span class="process-number">0{i + 1}</span>
              <p>{item.description}</p>
            </>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .process-illustration { display: grid; place-items: center; width: 54px; height: 54px; margin-bottom: 24px; border-radius: 16px; background: var(--paper); color: var(--forest); font-size: 28px; }
</style>
