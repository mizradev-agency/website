---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class:list={['icon', { 'icon-asterisk': name === 'asterisk' }]}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={name === 'asterisk' ? 1.5 : 1.25}
  stroke-linecap="butt"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name] ?? paths['arrow-up-right']} />
</svg>

<style>
  .icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    vertical-align: -0.125em;
  }
  .icon-asterisk {
    width: 0.75em;
    height: 0.75em;
    vertical-align: baseline;
  }
</style>
