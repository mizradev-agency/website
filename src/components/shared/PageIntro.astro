---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  action?: string;
  href?: string;
  showAction?: boolean;
}
const {
  showAction = true,
  eyebrow,
  title,
  text,
  action = 'Agendar una llamada',
  href = '/agendar-llamada',
} = Astro.props;
---

<section class="shell page-intro">
  <div class="page-intro-top">
    <span class="eyebrow">{eyebrow}</span><a href="/" class="back-home"
      >Mizradev <span aria-hidden="true">/</span> {eyebrow}</a>
  </div>
  <h1>{title}</h1>
  <div class="page-intro-bottom">
    <p>{text}</p><div class="page-intro-actions">
      {
        showAction && (
          <a class="button button-dark" href={href}>
            {action}
            <span aria-hidden="true">↗</span>
          </a>
        )
      }<a class="text-link" href="/contact"
        >Contactar por escrito <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
